# ---------- Client (exposed to browser; VITE_ prefix) ----------
# Sentry DSN is public by design. Leave blank to disable Sentry entirely.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# Flip to true once Even Realities glasses are in hand. Falls back to the Null adapter if unavailable.
VITE_ENABLE_EVEN_REALITIES=false
# Seconds between StepFun keyframe analyses during a workout (cold path).
VITE_STEPFUN_KEYFRAME_INTERVAL_S=8

# ---------- Server (proxy only; never shipped to browser) ----------
API_PORT=8787
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_MODEL=step-5-preview
# Fetch.ai uAgent / ASI:One REST endpoint (Python agent runs separately)
FETCH_AGENT_URL=
# Photon SMS/voice
PHOTON_API_KEY=
PHOTON_BASE_URL=
PHOTON_FROM_NUMBER=
